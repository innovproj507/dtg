# true = toda la web muestra /mantenimiento. En el VPS se controla en /etc/systemd/system/dtg-web.service
MAINTENANCE_MODE=false

# ── Envío del formulario de contacto ──
# Sin estos datos el formulario avisa de que el envío no está configurado, en
# vez de perder la solicitud en silencio. Son los del buzón de ventas.
#   cPanel / hosting propio : mail.bordadosdtg.com, puerto 465
#   Google Workspace        : smtp.gmail.com, puerto 465, contraseña de aplicación (no la del correo)
#   Microsoft 365           : smtp.office365.com, puerto 587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=ventas@bordadosdtg.com
SMTP_PASS=
# Remitente: debe ser una dirección del propio dominio o el servidor lo rechaza.
SMTP_FROM="DTG Bordados <ventas@bordadosdtg.com>"
# Destino de las solicitudes. Vacío = usa el correo de lib/contact.ts.
CONTACT_TO=ventas@bordadosdtg.com
